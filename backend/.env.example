# ─── Database ──────────────────────────────────────────────────────
# MongoDB Atlas connection string.
# Format: mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority&appName=CLUSTER
# Example: mongodb+srv://user:pass@cluster04.zio8msa.mongodb.net/genericmed?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://yashkaurani_db_user:4TJVd0FjRRa9y9Go@cluster04.zio8msa.mongodb.net/genericmed?retryWrites=true&w=majority&appName=Cluster04"

