// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum UserRole {
  patient
  pharmacy
  admin
  doctor
}

enum DosageForm {
  Tablet
  Capsule
  Syrup
  Injection
  Ointment
  Inhaler
}

enum FreshnessStatus {
  fresh
  warning
  stale
}

enum PrescriptionStatus {
  PendingReview
  Accepted
  Rejected
  Expired
}

enum OrderStatus {
  Created
  Paid
  Accepted
  Packed
  Shipped
  Delivered
  Cancelled
  Refunded
}

enum PaymentStatus {
  Initiated
  Pending
  Success
  Failed
  Refunded
}

enum PaymentMethod {
  CreditDebitCard
  UPIInstantPay
  NetBanking
  CashOnDelivery
}

enum AuditSource {
  WebUI
  PartnerPortal
  AdminConsole
  AutomatedSystem
}

enum TicketCategory {
  PrescriptionIssue
  PriceMismatch
  DeliveryDelay
  RefundRequest
  CatalogInquiry
}

enum TicketStatus {
  Open
  InProgress
  Resolved
  Closed
}

enum TicketPriority {
  Low
  Medium
  High
  Critical
}

// ─────────────────────────────────────────
// User & Auth
// ─────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String?
  role            UserRole  @default(patient)
  phone           String?
  licenseNumber   String?
  clinicHospital  String?
  pharmacyId      String?
  pharmacyName    String?
  address         String?
  avatarUrl       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  pharmacy        Pharmacy? @relation(fields: [pharmacyId], references: [id])
  prescriptions   Prescription[]
  orders          Order[]
  auditLogs       AuditRecord[]
  tickets         SupportTicket[]
  sessions        Session[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  data      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ─────────────────────────────────────────
// Pharmacy
// ─────────────────────────────────────────

model Pharmacy {
  id            String   @id @default(cuid())
  name          String
  licenseNumber String   @unique
  address       String
  city          String
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  slaMinutes    Int      @default(120)
  isActive      Boolean  @default(true)
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  users         User[]
  offers        SellerOffer[]
  orders        Order[]

  @@map("pharmacies")
}

// ─────────────────────────────────────────
// Medicine Catalog
// ─────────────────────────────────────────

model Medicine {
  id                     String     @id @default(cuid())
  name                   String
  brandName              String
  genericName            String
  activeIngredient       String
  dosageForm             DosageForm
  strength               String
  therapeuticClass       String
  isPrescriptionRequired Boolean    @default(false)
  manufacturer           String
  description            String
  commonUses             String[]
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  // Relations
  packs                  MedicinePack[]
  offers                 SellerOffer[]

  @@map("medicines")
}

model MedicinePack {
  id              String  @id @default(cuid())
  medicineId      String
  packQuantity    Int
  packUnit        String
  packLabel       String
  canonicalBarcode String  @unique

  // Relations
  medicine        Medicine       @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  offers          SellerOffer[]
  orderItems      OrderItem[]

  @@map("medicine_packs")
}

// ─────────────────────────────────────────
// Seller Offers (Pharmacy × Medicine × Pack)
// ─────────────────────────────────────────

model SellerOffer {
  id                  String          @id @default(cuid())
  pharmacyId          String
  medicineId          String
  packId              String
  price               Float
  mrp                 Float
  inStock             Boolean         @default(true)
  stockQuantity       Int             @default(0)
  deliveryEstimate    String
  deliveryFee         Float           @default(0)
  lastUpdated         DateTime        @default(now()) @updatedAt
  freshnessMinutesAgo Int             @default(0)
  freshnessStatus     FreshnessStatus @default(fresh)
  verifiedBadge       Boolean         @default(false)
  createdAt           DateTime        @default(now())

  // Relations
  pharmacy            Pharmacy        @relation(fields: [pharmacyId], references: [id])
  medicine            Medicine        @relation(fields: [medicineId], references: [id])
  pack                MedicinePack    @relation(fields: [packId], references: [id])

  @@unique([pharmacyId, medicineId, packId])
  @@map("seller_offers")
}

// ─────────────────────────────────────────
// Prescriptions
// ─────────────────────────────────────────

model Prescription {
  id                  String             @id @default(cuid())
  patientId           String
  doctorName          String
  doctorLicense       String
  clinicHospital      String
  prescribedDate      String
  validUntil          String
  uploadedAt          DateTime           @default(now())
  fileName            String
  fileSize            String
  fileUrl             String
  status              PrescriptionStatus @default(PendingReview)
  reviewedBy          String?
  reviewedAt          DateTime?
  rejectionReason     String?
  prescribedMedicines String[]
  diagnosisNote       String?
  matchedMedicineIds  String[]

  // Relations
  patient             User               @relation(fields: [patientId], references: [id])
  orders              Order[]

  @@map("prescriptions")
}

// ─────────────────────────────────────────
// Orders
// ─────────────────────────────────────────

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  patientId       String
  deliveryAddress String
  deliveryPhone   String
  pharmacyId      String
  subtotal        Float
  deliveryFee     Float
  tax             Float
  total           Float
  prescriptionId  String?
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(Initiated)
  paymentReference String?
  orderStatus     OrderStatus   @default(Created)
  trackingNumber  String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  patient         User              @relation(fields: [patientId], references: [id])
  pharmacy        Pharmacy          @relation(fields: [pharmacyId], references: [id])
  prescription    Prescription?     @relation(fields: [prescriptionId], references: [id])
  items           OrderItem[]
  statusHistory   OrderStatusEvent[]

  @@map("orders")
}

model OrderItem {
  id                     String  @id @default(cuid())
  orderId                String
  medicineId             String
  medicineName           String
  genericName            String
  packId                 String
  quantity               Int
  unitPrice              Float
  totalPrice             Float
  isPrescriptionRequired Boolean @default(false)

  // Relations
  order                  Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pack                   MedicinePack @relation(fields: [packId], references: [id])

  @@map("order_items")
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  timestamp DateTime    @default(now())
  actor     String
  note      String?

  // Relations
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_events")
}

// ─────────────────────────────────────────
// Audit Trail
// ─────────────────────────────────────────

model AuditRecord {
  id            String      @id @default(cuid())
  actorId       String?
  actorName     String
  role          String
  action        String
  target        String
  timestamp     DateTime    @default(now())
  reason        String?
  correlationId String
  source        AuditSource
  diffField     String?
  diffBefore    String?
  diffAfter     String?

  // Relations
  actor         User?       @relation(fields: [actorId], references: [id])

  @@map("audit_records")
}

// ─────────────────────────────────────────
// Support Tickets
// ─────────────────────────────────────────

model SupportTicket {
  id           String          @id @default(cuid())
  ticketNumber String          @unique
  userId       String
  orderId      String?
  subject      String
  category     TicketCategory
  status       TicketStatus    @default(Open)
  priority     TicketPriority  @default(Medium)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relations
  user         User            @relation(fields: [userId], references: [id])
  messages     TicketMessage[]

  @@map("support_tickets")
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  sender     String
  senderRole String
  text       String
  timestamp  DateTime @default(now())

  // Relations
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}
