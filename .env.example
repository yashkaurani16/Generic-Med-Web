# ─── Database ──────────────────────────────────────────────────────
# Required: PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local example: postgresql://postgres:password@localhost:5432/genericmed
# Supabase example: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/genericmed"

# ─── AI ────────────────────────────────────────────────────────────
# Required for Gemini AI prescription OCR.
# AI Studio automatically injects this at runtime from user secrets.
# Without this, the app falls back to built-in sample prescription data.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── App ───────────────────────────────────────────────────────────
# The URL where this app is hosted (used for CORS, OAuth callbacks).
APP_URL="http://localhost:3000"

# ─── Session ───────────────────────────────────────────────────────
# CRITICAL: Change this to a long random string in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-in-production"

# ─── Payments ─────────────────────────────────────────────────────
# Razorpay (India — UPI, NetBanking, Cards)
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="XXXXXXXXXXXXXXXXXXXXXX"

# Stripe (International)
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY="pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
STRIPE_SECRET_KEY="sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
STRIPE_WEBHOOK_SECRET="whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ─── Environment ───────────────────────────────────────────────────
# Set to 'production' in deployed environments
NODE_ENV="development"
